# Keep the Docker/Space build context tiny. The runtime data slice is pulled
# from the HF Dataset at boot (scripts/bootstrap_hf_data.py), NOT baked into the
# image — never COPY the 54 GB data/ tree.
data/
.venv/
venv/

# eval_results/ IS needed: the Report tab (Flow C) reads aggregate.csv,
# pairwise.csv, manifest.json and the per-question parquets from it
# (ui/eval_results.py, ui/services/report_data.py). Ship it -- but not the
# 262 MB json/ export, which no app code reads, nor the llama variant.
eval_results/json/
eval_results/_garbage_h1_agentworkflow/
eval_results_llama/
error_analysis.txt

# caches / vcs / junk
.git/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage*
*.log

# notebooks aren't needed to serve the app
notebooks/

# local secrets never go into the image (set them as HF Space secrets)
.env
api_key
insa_api_key

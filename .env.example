# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Which model uses which provider is defined in config/models.yml.

# --- Provider API keys -----------------------------------------------------
# DeepInfra: main LLM (Llama 3.3 70B) + embeddings + DeepSeek-V3 judge
DEEPINFRA_API_KEY=
# OpenRouter: Gemma judge
OPENROUTER_API_KEY=
# Hugging Face: local embedding baseline (all-mpnet-base-v2) + model downloads
HF_TOKEN=
# NVIDIA NIM (optional): hosts snowflake/arctic-embed-l, NV-Embed, etc.
NVIDIA_KEY=

# --- PostgreSQL + pgvector (vector store; WS4 docker-compose) --------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_postgres

# --- Neo4j (graph store) ---------------------------------------------------
# Host ports the docker-compose neo4j publishes (change if 7474/7687 are taken
# by other Neo4j containers). NEO4J_URI must match NEO4J_BOLT_PORT.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jfoodrag

# --- NebulaGraph (optional, legacy; foodrag[nebula]) -----------------------
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula

# --- GUI: interaction logging (spec §9) ------------------------------------
# Primary sink: private HF Dataset repo. Set both to enable remote log push
# (uses HF_TOKEN above). Leave FOODRAG_DATASET_REPO empty for in-memory only.
FOODRAG_DATASET_REPO=
# Secondary sink (optional): Supabase Postgres over HTTPS for real-time queries.
SUPABASE_URL=
SUPABASE_KEY=

# --- GUI: live backend + admin ---------------------------------------------
# Force Flow A's "Run pipeline" to use the real agentic backend (else opt-in via
# the admin panel). Admin panel password (dev fallback "admin" if unset).
FOODRAG_REAL_BACKEND=
ADMIN_PASSWORD=

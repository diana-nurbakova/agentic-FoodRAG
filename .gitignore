.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# Ignore all files in any output or data directory
*/output/*
*/output/*/*
*/output/*/*/*
*/data/*
*/data/*/*
*/data/*/*/*
*/*/data/*
*/*/data/*/*
*/*/data/*/*/*
# The data-ignoring globs above also match the source package src/foodrag/data/.
# The source tree is always code, never data — never ignore it.
!src/**
# ...but still never track byte-code caches under src (the negation above would
# otherwise re-include them).
src/**/__pycache__/

*/error_analysis.txt
*/logfile.txt
logfile.txt
*/logfile_*.txt
logfile_*.txt
config/api-key
test.ipynb

# Top-level data directory: external datasets + generated artifacts (multi-GB).
# The patterns above only catch nested */data/*, not the root data/ dir.
/data/

# Tooling caches (uv venv is covered by .venv above)
.ruff_cache/
uv-cache/

specs/
thesis/
mockups/

.claude/